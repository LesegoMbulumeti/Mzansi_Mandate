# Copy to .env. These values are development-only; replace all secrets before deployment.
APP_ENV=development
DATABASE_URL=sqlite:///./mandate.db
CORS_ORIGINS=http://localhost:3000
BUSINESS_TIMEZONE=Africa/Johannesburg
POSTGRES_USER=mandate
POSTGRES_PASSWORD=mandate_local_dev_password
POSTGRES_DB=mandate

# Local demo credentials. Never expose the admin key to browser JavaScript.
ADMIN_API_KEY=local-admin-change-me
AGENT_API_KEY=local-agent-change-me
N8N_SHARED_SECRET=local-n8n-change-me
N8N_INBOUND_WEBHOOK_SECRET=local-n8n-invoice-hook-change-me
N8N_ENCRYPTION_KEY=local-n8n-encryption-key-change-this-value
ADMIN_LOGIN_PASSWORD=change-this-local-password
SESSION_SECRET=local-session-secret-change-me-32-characters-minimum

# XRPL payment execution is off by default. Enable only after funding a dedicated test wallet.
XRPL_NETWORK=testnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_PAYMENTS_ENABLED=false
TREASURY_ADDRESS=
POLICY_SIGNER_SEED=
RLUSD_ISSUER=

# Next.js server-to-server API connection; the key remains server-side.
MANDATE_API_URL=http://localhost:8000
MANDATE_ADMIN_API_KEY=local-admin-change-me
