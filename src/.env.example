APP_ENV=development
DATABASE_URL=sqlite:///./mandate.db
CORS_ORIGINS=http://localhost:3000
BUSINESS_TIMEZONE=Africa/Johannesburg
POSTGRES_USER=mandate
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=mandate

# Local demo credentials. Replace these before using the app beyond localhost.
ADMIN_API_KEY=replace-with-admin-secret
AGENT_API_KEY=replace-with-agent-secret
N8N_SHARED_SECRET=replace-with-n8n-secret
N8N_INBOUND_WEBHOOK_SECRET=replace-with-inbound-webhook-secret
N8N_ENCRYPTION_KEY=replace-with-n8n-encryption-key
ADMIN_LOGIN_PASSWORD=replace-with-local-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Dedicated XRPL test wallet configuration. Keep execution disabled until ready.
XRPL_NETWORK=testnet
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233
XRPL_PAYMENTS_ENABLED=false
TREASURY_ADDRESS=
POLICY_SIGNER_SEED=
RLUSD_ISSUER=

# Server-side Next.js connection. Do not use NEXT_PUBLIC_ for this key.
MANDATE_API_URL=http://localhost:8000
MANDATE_ADMIN_API_KEY=replace-with-admin-secret
